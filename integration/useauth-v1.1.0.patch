+describe("account management", () => {
+  it("reports the configured Supabase project to server consumers", async () => {
+    const response = await handleAuth(request({}, { method: "GET" }), "project", "token");
+    expect(response.status).toBe(200);
+    expect(await response.json()).toEqual({ supabase_url: "https://test.supabase.co" });
+  });
+
+  it("sends reset links to the fixed UseAuth recovery route without revealing account existence", async () => {
+    mocks.auth.resetPasswordForEmail.mockResolvedValue({ error: null });
+    const response = await handleAuth(request({ email: "TEST@example.com" }), "request-reset", "token");
+    expect(response.status).toBe(200);
+    expect(mocks.auth.resetPasswordForEmail).toHaveBeenCalledWith("test@example.com", {
+      redirectTo: "https://auth.example.com/auth/recovery",
+    });
+    expect(JSON.stringify(await response.json())).not.toContain("test@example.com");
+  });
+
+  it("requires a valid token session to change passwords", async () => {
+    mocks.auth.setSession.mockResolvedValue({ data: { session: null, user: null }, error: { message: "invalid" } });
+    const response = await handleAuth(request({ access_token: "access", refresh_token: "refresh", current_password: "old", new_password: "new-secret" }), "change-password", "token");
+    expect(response.status).toBe(401);
+    expect(mocks.auth.updateUser).not.toHaveBeenCalled();
+  });
+
+  it("requires a recovery token before setting a forgotten password", async () => {
+    mocks.auth.verifyOtp.mockResolvedValue({ error: { message: "expired" } });
+    const response = await handleAuth(request({ token_hash: "expired", password: "new-secret" }, { origin: "https://auth.example.com" }), "reset-password", "cookie");
+    expect(response.status).toBe(401);
+    expect(mocks.auth.updateUser).not.toHaveBeenCalled();
