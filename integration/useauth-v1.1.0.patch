+import { AuthLayout } from "@/components/auth-layout";
+import { PasswordForm } from "@/components/password-form";
+import { isConfigured } from "@/lib/config";
+
+export const metadata = { title: "Reset password", referrer: "no-referrer" as const };
+export const dynamic = "force-dynamic";
+
+export default async function ResetPassword({ searchParams }: { searchParams: Promise<{ token_hash?: string }> }) {
+  if (!isConfigured()) redirect("/forgot-password");
