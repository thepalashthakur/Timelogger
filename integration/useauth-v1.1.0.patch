 }));
 vi.mock("@/lib/supabase/server", () => ({
@@ -70,6 +71,32 @@ beforeEach(() => {
   vi.stubEnv("ANDROID_APP_REDIRECT_URL", "useauth-android://auth/confirmed");
 });
 
+describe("account updates for consuming apps", () => {
+  it("requires a valid token session to change the password", async () => {
+    mocks.auth.setSession.mockResolvedValue({ data: { session: null, user: null }, error: { message: "invalid" } });
+    const response = await handleAuth(request({ access_token: "access", refresh_token: "refresh", current_password: "old", new_password: "new-secret" }), "change-password", "token");
+    expect(response.status).toBe(401);
+    expect(mocks.auth.updateUser).not.toHaveBeenCalled();
+  });
+
+  it("requires the current password and relays a reauthentication request", async () => {
+    mocks.auth.setSession.mockResolvedValue({ data: { session, user }, error: null });
+    mocks.auth.updateUser.mockResolvedValue({ data: { user: null }, error: { code: "reauthentication_needed", message: "Code required", status: 400 } });
+    const response = await handleAuth(request({ access_token: "access", refresh_token: "refresh", current_password: "old", new_password: "new-secret" }), "change-password", "token");
+    expect(response.status).toBe(400);
+    expect(mocks.auth.updateUser).toHaveBeenCalledWith({ password: "new-secret", current_password: "old" });
+    expect(await response.json()).toEqual({ error: { code: "reauthentication_needed", message: "Code required" } });
+  });
+
+  it("updates the signed-in user's display name", async () => {
+    mocks.auth.setSession.mockResolvedValue({ data: { session, user }, error: null });
+    mocks.auth.updateUser.mockResolvedValue({ data: { user: { ...user, user_metadata: { ...user.user_metadata, display_name: "New name" } } }, error: null });
+    const response = await handleAuth(request({ access_token: "access", refresh_token: "refresh", display_name: "New name" }), "update-profile", "token");
+    expect(response.status).toBe(200);
+    expect(mocks.auth.updateUser).toHaveBeenCalledWith({ data: { display_name: "New name" } });
+  });
+});
+
 describe("authentication boundaries", () => {
   it("requires configuration instead of attempting an auth request", async () => {
     vi.stubEnv("SUPABASE_URL", "");
