diff --git a/src/lib/auth-contract.ts b/src/lib/auth-contract.ts
index a88ac21..4ad3ea1 100644
--- a/src/lib/auth-contract.ts
+++ b/src/lib/auth-contract.ts
@@ -48,6 +48,14 @@ export const resetPassword = z
     password: z.string().min(8, "Use at least 8 characters.").max(128),
   })
   .strict();
+export const tokenPasswordChange = logout.extend({
+  current_password: z.string().min(1).max(128),
+  new_password: z.string().min(8).max(128),
+  nonce: z.string().trim().min(1).max(20).optional(),
+});
+export const tokenProfileUpdate = logout.extend({
+  display_name: z.string().trim().max(80),
+});
 export const actions = [
   "sign-up",
   "sign-in",
@@ -56,6 +64,9 @@ export const actions = [
   "refresh",
   "sign-out",
   "me",
+  "change-password",
+  "reauthenticate",
+  "update-profile",
 ] as const;
 export type AuthAction = (typeof actions)[number];
 
diff --git a/src/lib/auth-handler.ts b/src/lib/auth-handler.ts
index 582c0ac..d2d1e68 100644
--- a/src/lib/auth-handler.ts
+++ b/src/lib/auth-handler.ts
@@ -10,6 +10,8 @@ import {
   logout,
   forgotPassword,
   resetPassword,
+  tokenPasswordChange,
+  tokenProfileUpdate,
   recoveryReturnUrl,
   publicUser,
   type AuthAction,
@@ -339,6 +341,35 @@ export async function handleAuth(
         user: publicUser(data.user!),
       });
     }
+    if (mode === "token" && ["change-password", "reauthenticate", "update-profile"].includes(action)) {
+      const parsed = (action === "change-password" ? tokenPasswordChange : action === "update-profile" ? tokenProfileUpdate : logout).safeParse(input);
+      if (!parsed.success) return fail("VALIDATION_ERROR", "Invalid account request.", 400);
+      const { data: active, error: sessionError } = await client.auth.setSession({
+        access_token: parsed.data.access_token,
+        refresh_token: parsed.data.refresh_token,
+      });
+      if (sessionError || !active.session || !active.user)
+        return fail("UNAUTHORIZED", "Your session is invalid or expired.", 401);
+      if (action === "reauthenticate") {
+        const { error } = await client.auth.reauthenticate();
+        if (error) return fail(error.code ?? "REAUTHENTICATION_FAILED", error.message, error.status ?? 400);
+        return json({ message: "Verification code sent.", session: sessionData(active.session) });
+      }
+      if (action === "change-password") {
+        const values = tokenPasswordChange.parse(input);
+        const { data, error } = await client.auth.updateUser({
+          password: values.new_password,
+          current_password: values.current_password,
+          ...(values.nonce ? { nonce: values.nonce } : {}),
+        });
+        if (error) return fail(error.code ?? "PASSWORD_CHANGE_FAILED", error.message, error.status ?? 400);
+        return json({ user: publicUser(data.user!), session: sessionData(active.session), message: "Password changed." });
+      }
+      const values = tokenProfileUpdate.parse(input);
+      const { data, error } = await client.auth.updateUser({ data: { display_name: values.display_name } });
+      if (error) return fail(error.code ?? "PROFILE_UPDATE_FAILED", error.message, error.status ?? 400);
+      return json({ user: publicUser(data.user!), session: sessionData(active.session) });
+    }
     if (mode === "token") {
       const parsed = logout.safeParse(input);
       if (!parsed.success)
